# ============================================
# ChunkSmith Backend - Environment Variables
# Copy to .env and fill in values
# ============================================

# ---- Supabase (required for auth, storage, PostgreSQL) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Storage bucket names (must exist in Supabase Storage)
SUPABASE_PDF_BUCKET_NAME=chunk_pdf
SUPABASE_BUCKET_NAME=chunk_images
SUPABASE_PKL_BUCKET_NAME=chunk_pkl
SUPABASE_DATA_BUCKET_NAME=chunk_data

# ---- Azure OpenAI (required for AI summarization & embeddings) ----
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---- Unstructured (required for PDF parsing) ----
UNSTRUCTURED_API_KEY=your-unstructured-api-key

# ---- Qdrant (required for vector search) ----
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ---- Optional ----
# EXTERNAL_API_URL=https://your-app.onrender.com
# GOOGLE_API_KEY=optional-google-embedding-key

# Email confirmation redirect (signup link in email). Use your deployed frontend URL.
# SITE_URL=https://multi-modul-rag.vercel.app
