%%{init: {'theme': 'base', 'themeVariables': { 'fontFamily': 'Times New Roman', 'fontSize': '14px'}}}%%
flowchart TB
    %% --- Tier 1: Interaction Layer ---
    subgraph Client [Client Interaction Layer]
        direction LR
        User((User))
        UI[React Frontend Interface]
        UploadHook[File Upload Hook]
        QueryHook[Chat Interface Hook]
    end

    %% --- Tier 2: API Gateway Layer ---
    subgraph Gateway [API Gateway]
        direction TB
        IngestEP[POST /ingest Endpoint]
        RetrieveEP[POST /chat Endpoint]
        Auth[Authentication Middleware]
    end

    %% --- Tier 3: Ingestion and Processing Core ---
    subgraph Core [Core Processing Engine]
        direction TB
        
        subgraph Validation [Step 1: Validation and Deduplication]
            direction LR
            Hasher[SHA-256 Hasher]
            MimeCheck[MIME Type Validator]
            Dedup{Duplicate Check}
        end

        subgraph Decomposition [Step 2: Decomposition Strategy]
            direction TB
            PDFRender[pdf2image Renderer\n300 DPI]
            YOLO[Layout Analysis Model\nYOLOv11]
            Filter{Visual Object Filter\nArea/Aspect Ratio}
        end

        subgraph Extraction [Step 3: Text and Data Extraction]
            direction LR
            OCR[Tesseract OCR\nLSTM Engine]
            TableExt[Table Structure Extraction]
            Chunker[Sliding Window Chunker\nSize=3000, Stride=2800]
        end
    end

    %% --- Tier 4: Semantic Enrichment ---
    subgraph Intelligence [Multimodal Semantic Enrichment]
        direction TB
        Prompt[Structured Prompt Builder\nTask Decomposition]
        
        subgraph InferBackend [Asynchronous Inference Backend]
            direction TB
            Scheduler[Async Scheduler\nSemaphore Concurrency=15]
            KeyPool[API Key Rotation Pool\nRound-Robin]
            MLLM[Multimodal LLM\nGemini/GPT-4V]
        end
        
        Parser[AI Output Parser\nPydantic Validation]
    end

    %% --- Tier 5: Storage Infrastructure ---
    subgraph Persistence [Data Persistence Layer]
        direction TB
        subgraph BlobStore [Object Storage]
            Bucket[S3/MinIO Bucket\nRaw Images and PDFs]
        end
        
        subgraph VectorStore [Vector Database]
            Qdrant[Qdrant Collection]
            EmbedModel[Embedding Model\nHigh-Dimensional]
        end
    end

    %% --- Tier 6: Retrieval and Generation ---
    subgraph GenFlow [Retrieval and Generation Flow]
        direction TB
        VectorSearch[HNSW Vector Search\nTop-K Retrieval]
        ContextManage[Context Manager\nDeduplication Logic]
        RAGAgent[Generation Agent]
    end

    %% ================= CONNECTIONS =================

    %% User Interaction
    User --> UI
    UI --> UploadHook
    UI --> QueryHook
    UploadHook --> Auth --> IngestEP
    QueryHook --> Auth --> RetrieveEP

    %% Ingestion Pipeline
    IngestEP --> Hasher --> Dedup
    Dedup -->|New File| MimeCheck --> PDFRender
    Dedup -->|Exists| End((End))

    PDFRender --> YOLO
    YOLO -->|Text Regions| OCR
    YOLO -->|Tables| TableExt
    YOLO -->|Images| Filter
    
    Filter -->|Valid| Bucket
    Filter -->|Valid| Prompt
    OCR --> Chunker --> Prompt
    TableExt --> Prompt

    %% Semantic Enrichment
    Prompt --> Scheduler
    Scheduler --> KeyPool --> MLLM
    MLLM --> Parser
    Parser --> EmbedModel
    EmbedModel --> Qdrant
    Bucket -.->|Image URLs| Qdrant

    %% Retrieval Pipeline
    RetrieveEP --> EmbedModel
    EmbedModel --> VectorSearch
    VectorSearch -->|Chunks + Metadata| ContextManage
    
    ContextManage -->|Filtered Context| RAGAgent
    RAGAgent -->|Answer + Citations| UI

    %% Styling
    classDef layer fill:#f9f9f9,stroke:#333,stroke-width:2px;
    classDef process fill:#e1f5fe,stroke:#01579b,stroke-width:1px;
    classDef storage fill:#fff3e0,stroke:#e65100,stroke-width:1px;
    classDef component fill:#ffffff,stroke:#333,stroke-width:1px,stroke-dasharray: 5 5;

    class Client,Gateway,Core,Intelligence,Persistence,GenFlow layer
    class IngestEP,RetrieveEP,Auth,Hasher,MimeCheck,PDFRender,YOLO,OCR,TableExt,Chunker,Prompt,Scheduler,KeyPool,MLLM,Parser,EmbedModel,VectorSearch,ContextManage,RAGAgent,Filter process
    class Bucket,Qdrant storage
    class User,UI,UploadHook,QueryHook component
