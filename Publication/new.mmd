%%{init: {'theme': 'base', 'themeVariables': { 'fontFamily': 'Times New Roman', 'fontSize': '50px'}}}%%
flowchart TB
    %% Level 1: Client Layer (Horizontal Row)
    subgraph Client [Client Interface]
        direction LR
        UI["User Interface"]
        Upload["PDF Upload"]
        Query["User Query"]
    end

    %% Level 2: API Layer (Horizontal Row)
    subgraph API [FastAPI Backend]
        direction LR
        IngestAPI["Ingestion Endpoint"]
        Scheduler["Async Scheduler"]
        RetrievalAPI["Retrieval Endpoint"]
    end

    %% Level 3: Processing Layer (Horizontal Row)
    subgraph Processing [Content Processor]
        direction LR
        PDF["PDF Processing"]
        Layout["Layout Analysis\n(YOLOv12)"]
        OCR["Tesseract OCR"]
    end

    %% Level 4: Intelligence (Horizontal Row)
    subgraph Intelligence [Semantic Enrichment]
        direction LR
        Prompt["Structured Prompt"]
        Gemini["Multimodal LLM"]
    end

    %% Level 5: Storage (Horizontal Row)
    subgraph Storage [Data Persistence]
        direction LR
        SupabaseObj["Bucket Storage"]
        Qdrant["Vector DB"]
    end

    %% Connections Flow: Client -> API -> Process -> Intel -> Storage
    UI --> Upload
    Upload --> IngestAPI
    Query --> RetrievalAPI

    IngestAPI --> PDF
    PDF --> Layout
    Layout --> OCR
    OCR --> Scheduler
    Layout --> SupabaseObj

    Scheduler --> Gemini
    Prompt --> Gemini
    Gemini --> Qdrant
    SupabaseObj --> Scheduler

    RetrievalAPI --> Gemini
    Gemini --> Qdrant
    Qdrant --> RetrievalAPI
    RetrievalAPI --> UI

     UI:::component
     Upload:::component
     Query:::component
     IngestAPI:::process
     RetrievalAPI:::process
     Scheduler:::process
     Gemini:::external
     Prompt:::process
     PDF:::process
     OCR:::external
     Layout:::process
     SupabaseObj:::storage
     Qdrant:::storage
     classDef storage fill:#fff,stroke:#000,stroke-width:2px,color:#000
    classDef process fill:#f0f0f0,stroke:#000,stroke-width:2px,color:#000
    classDef component fill:#fff,stroke:#000,stroke-width:1px,stroke-dasharray: 5 5,color:#000
    classDef external fill:#e0e0e0,stroke:#000,stroke-width:2px,color:#000
