# ==============================================================================
# ChunkSmith Fullstack (Next.js + TypeScript Backend on Vercel)
# ==============================================================================

# Supabase (PostgreSQL Database & Storage Buckets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET_NAME=chunk_images
SUPABASE_DATA_BUCKET_NAME=chunk_data
SUPABASE_PDF_BUCKET_NAME=chunk_pdf
SUPABASE_PKL_BUCKET_NAME=chunk_pkl

# Multi-Account Key Pool (Supports 10+ Gemini accounts & 10+ Groq accounts)
# Comma-separated list with automatic rotation and instantaneous fallback on 429 rate limit:
GEMINI_KEYS="AIzaSyA_key1,AIzaSyB_key2,AIzaSyC_key3,AIzaSyD_key4"
GROQ_KEYS="gsk_key1,gsk_key2,gsk_key3,gsk_key4"

# Dynamic Model Selection (Change whenever you want without code edits):
GEMINI_MODEL=gemini-1.5-flash
# Other options: gemini-1.5-pro, gemini-2.0-flash, gemini-2.0-flash-lite

GROQ_MODEL=llama-3.3-70b-versatile
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it

GEMINI_EMBEDDING_MODEL=text-embedding-004

# Single Google Gemini Key fallback
GOOGLE_API_KEY=your-google-api-key

# Qdrant Vector Database (Cloud)
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key

# Unstructured API (Document & PDF Partitioning)
UNSTRUCTURED_API_KEY=your-unstructured-api-key
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general