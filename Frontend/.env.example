# ==============================================================================
# ChunkSmith Fullstack (Next.js + TypeScript Backend on Vercel)
# ==============================================================================

# Supabase (PostgreSQL Database & Storage Buckets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET_NAME=chunk_images
SUPABASE_DATA_BUCKET_NAME=chunk_data
SUPABASE_PDF_BUCKET_NAME=chunk_pdf
SUPABASE_PKL_BUCKET_NAME=chunk_pkl

# Portkey AI Gateway (Supports multiple API keys, routing, failover & load balancing)
PORTKEY_API_KEY=your-portkey-api-key
PORTKEY_CONFIG_ID=
PORTKEY_VIRTUAL_KEY=

# Direct LLM Settings (Azure OpenAI / OpenAI Fallback)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_CHAT_MODEL=gpt-4o
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=your-openai-api-key

# Google Gemini (Embeddings for Vector Search)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# Qdrant Vector Database (Cloud)
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key

# Unstructured API (Document & PDF Partitioning)
UNSTRUCTURED_API_KEY=your-unstructured-api-key
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general